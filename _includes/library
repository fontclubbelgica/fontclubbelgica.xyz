{% if page.font_match %}
    {% assign typefaces = [] %}
    {% for font_match in page.font_match %}
        {% assign match = site.typefaces | where: 'title', font_match %}
        {% assign typefaces = typefaces | concat: match %}
    {% endfor %}
{% else %}
    {% assign typefaces = site.typefaces limit:include.fontcount %}
{% endif %}
{% assign typefaces = typefaces | where: "draft", "false" | sort:"date" %}

{% if typefaces.size > 0 %}
<section class="library">
    {% if page.layout == "article" %}
    <h2>Fonts mentioned in this article</h2>
    {% endif %}
    <div class="grid">
        {% for typeface in typefaces %}
        <div class="preview-font">
            <a href="{{ typeface.url }}">
                <div class="stack stack-{{ typeface.library_preview | size }}">
                {% for library-preview in typeface.library_preview %}
                    <figure><img src="{{ typeface.url }}{{ library-preview }}"></figure>
                {% endfor %}
                </div>
                <div class="font-info">
                    <h2>{{ typeface.title }}</h2>
                    <p class="total">{{ typeface.styles | size }} styles</p>
                </div>
            </a>
        </div>
        {% endfor %}
        {% unless include.fontcount %}
        <div class="more"><p>and many<br>more to<br>come!</p></div>
        {% endunless %}
    </div>
    {% if include.fontcount %}
    <p><a href="/typefaces" class="library-btn">Explore full library</a></p>
    {% endif %}
</section>
{% endif %}