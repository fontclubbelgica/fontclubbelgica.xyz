<section class="table">
    <div class="table-wrap">
        <table>
            <tr>
                <th>Name</th>
                <th>Styles</th>
                <th>Weights</th>
                <th>Widths</th>
                <th>Italics</th>
                <th>Variable</th>
                <th>Latin CE</th>
                <th>Cyrillic</th>
                <th>Greek</th>
                <th>Vietnam</th>
                <th>Serial#</th>
            </tr>

            {% assign typefaces = site.typefaces | sort:"date" %}
            {% for typeface in typefaces %}
                <tr {% if typeface.draft %}class="wip"{% endif %}>
                    {% if typeface.draft %}
                    <th>{{ typeface.title }}</th>
                    {% else %}
                    <th><a href="{{ typeface.url }}">{{ typeface.title }}</a></th>
                    {% endif %}
                    <td>{{ typeface.styles | size }}</td>
                    <td>{{ typeface.technicalSupport.weights }}</td>
                    <td>{{ typeface.technicalSupport.widths }}</td>
                    <td>{% if typeface.technicalSupport.italics %}✅{% endif %}</td>
                    <td>{% if typeface.technicalSupport.variable %}✅{% endif %}</td>
                    <td>{% if typeface.technicalSupport.latin %}✅{% endif %}</td>
                    <td>{% if typeface.technicalSupport.cyrillic %}✅{% endif %}</td>
                    <td>{% if typeface.technicalSupport.greek %}✅{% endif %}</td>
                    <td>{% if typeface.technicalSupport.vietnamese %}✅{% endif %}</td>
                    {% if typeface.draft %}
                    <td>FC.20??.??</td>
                    {% else %}
                    <td>FC.{{ typeface.date | date: "%Y" }}.{{ typeface.date | date: "%m" }}</td>
                    {% endif %}
                </tr>
            {% endfor %}
        </table>
    </div>
</section>