<!-- footer -->

<footer>
    <div class="row top">
        <div class="col-6">
            <p>Get access to new fonts and the latest news:</p>
            <p>[newsletter - depending on service]</p>
        </div>
        <div class="col-6">
            <p>For any enquiries please email us:</p>
            <p>{% include mail a="info" %}</p>
        </div>
    </div>
    <div class="row bottom">
        <div class="col-4">
            <h2>{% include fcb %}</h2>
        </div>
        <nav class="col-2">
            <h2>Socials</h2>
            <ul>
                <li><a href="https://www.instagram.com/fontclubbelgica">Instagram</a></li>
                <li><a href="#">Mastodon</a></li>
            </ul>
        </nav>
        <nav class="col-2">
            <h2><a href="/typefaces">Our typefaces</a></h2>
            <ul>
                {% for fontpage in site.typefaces %}
                    {% unless fontpage.draft %}
                        <li><a href="{{ fontpage.url }}">{{ fontpage.title }}</a></li>
                    {% endunless %}
                {% endfor %}
            </ul>
        </nav>
        <nav class="col-2">
            <h2>Information</h2>
            <ul>
                <li><a href="/faq#about-us">About us</a></li>
                <li><a href="/faq#our-team">Our Team</a></li>
                <li><a href="/faq#our-services">Our Services</a></li>
                <li><a href="/faq#contact">Contact</a></li>
                <li><a href="/faq#trial-fonts">Trial Fonts</a></li>
            </ul>
        </nav>
        <nav class="col-2">
            <h2>Support</h2>
            <ul>
                <li><a href="#">Payments</a></li>
                <li><a href="#">Licensing</a></li>
                <li><a href="/faq#EULA">EULA</a></li>
                <li><a href="/faq#legal">Legal</a></li>
                <li><a href="#">GDPR</a></li>
            </ul>
        </nav>
        <div class="col-12">
            <p class="copy">&copy; <script>document.write(new Date().getFullYear())</script> {% include fcb %}. All Rights Reserved. Don’t steal fonts!</p>
        </div>
    </div>
</footer>