{% assign exclude_word = "Large" %}
{% assign typeface_collection = site.collections | where: "label", "typefaces" | first %}
{% assign all_library = typeface_collection.files | where_exp: "f", "f.extname == '.svg'" | where_exp: "f", "f.name contains '_Library_'" %}
{% assign published_names = "" | split: "" %}
{% for doc in typeface_collection.docs %}
{% if doc.draft == false %}
{% assign doc_name = doc.path | split: "/" | last | remove: ".md" | downcase %}
{% assign published_names = published_names | push: doc_name %}
{% endif %}
{% endfor %}
{% assign library_svgs = "" | split: "" %}
{% for f in all_library %}
{% assign svg_folder = f.path | split: "_typefaces/" | last | split: "/" | first | downcase %}
{% unless f.name contains exclude_word %}{% if published_names contains svg_folder %}{% assign library_svgs = library_svgs | push: f %}{% endif %}{% endunless %}
{% endfor %}
<!-- idle-bouncer: {{ library_svgs.size | default: 0 }} SVGs used | _Library_ SVGs before filtering: {{ all_library.size | default: 0 }} | typeface docs: {{ typeface_collection.docs.size | default: 0 }} | published typefaces: {{ published_names | join: ", " }} | docs seen: {% for doc in typeface_collection.docs %}[{{ doc.path }} draft={{ doc.draft }}] {% endfor %}| names containing "{{ exclude_word }}" are skipped -->
{% if library_svgs.size > 0 %}
<style>
  #idle-bouncer {
    position: fixed;
    inset: 0;
    z-index: 9999;
    overflow: hidden;
    pointer-events: none;
    opacity: 1;
  }
  #idle-bouncer.is-hiding { opacity: 0; }
  #idle-bouncer img {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    max-width: none;
    max-height: none;
    margin: 0;
    pointer-events: none;
    will-change: transform;
  }
</style>
<script>
(function () {
  'use strict';

  /* ------------------------------------------------------------------ *
   *  SETTINGS
   * ------------------------------------------------------------------ */
  var CONFIG = {
    idleSeconds: 60,       // inactivity before the animation starts
    leader: {{ '/assets/FCB_Library_Trail.svg' | relative_url | jsonify }},  // the bouncing square
    sizeUnit: 'percent',   // 'percent' = size relative to the browser window, 'px' = fixed pixels
    size: 15,              // 8 = 8% of the window (or 120 = 120 px when sizeUnit is 'px')
    sizeBasedOn: 'smallest',  // percent of what? 'width', 'height' or 'smallest' (the shorter side)
    minSize: 40,           // never smaller than this many px (0 = no limit)
    maxSize: 0,            // never bigger than this many px (0 = no limit)
    cornerRadius: 18,      // corner radius of every square, in px
    backgroundColor: '#ffffff', // colour behind every square, visible through transparent parts
                           // of an SVG ('transparent' = none)
    speed: 300,            // speed of the bouncing square, in px per second
    dropEvery: 12,         // WANTED distance between two squares, as % of the browser size.
                           // The real distance is adjusted a little for every stretch between two
                           // borders, so the squares are spread evenly and one lands exactly on
                           // each border (smaller number = denser trail)
    dropEveryBasedOn: 'smallest', // percent of what? 'width', 'height' or 'smallest' (the shorter side)
    maxDrops: 23,          // max SVGs kept on screen (0 = unlimited, oldest removed first)
    order: 'random',       // order of the dropped SVGs: 'random' or 'sequential'
    differentFolderEachDrop: true, // true = every dropped square comes from a different typeface
                           // folder than the one before it (needs 2 or more folders)

    // Drop shadow (applies to the bouncing square and the trail)
    shadow: true,                      // true = on, false = off
    shadowSize: 24,                    // blur of the shadow, in px (bigger = softer and wider)
    shadowColor: 'rgba(0, 0, 0, 0.25)',

    // Slowly fade out the dropped SVGs (the trail)
    fade: true,             // true = trail fades away, false = trail stays until activity
    fadeDelaySeconds: 12,  // how long a dropped SVG stays fully visible before it starts fading
    fadeDurationSeconds: 10, // how long the fade takes (bigger = slower)

    fadeOutMs: 600,        // fade-out of everything when the visitor returns
    respectReducedMotion: true  // do nothing if the OS asks for reduced motion
  };

  /* ------------------------------------------------------------------ *
   *  SVG LIST (generated by Jekyll)
   * ------------------------------------------------------------------ */
  var SVGS = [{% for f in library_svgs %}{% assign rel = f.path | split: "_typefaces/" | last %}{{ rel | prepend: "/typefaces/" | relative_url | uri_escape | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}];
  // The typeface folder of each SVG above (same order)
  var SVG_FOLDERS = [{% for f in library_svgs %}{{ f.path | split: "_typefaces/" | last | split: "/" | first | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}];

  if (!SVGS.length) return;
  if (CONFIG.respectReducedMotion && window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  /* ------------------------------------------------------------------ *
   *  STATE
   * ------------------------------------------------------------------ */
  var layer = null, leader = null;
  var running = false, rafId = 0, idleTimer = 0;
  var seg = null, lastT = 0, dropPx = 1;   // seg = the straight stretch of the path we are on
  var queue = [], seqIndex = 0, preloaded = false, sizePx = 0;

  // SVGs grouped per typeface folder (for differentFolderEachDrop)
  var groups = Object.create(null), folderNames = [];
  var folderQueue = [], folderSeq = 0, lastFolder = null;
  var srcQueues = Object.create(null), srcSeq = Object.create(null);
  SVGS.forEach(function (src, i) {
    var f = SVG_FOLDERS[i];
    if (!groups[f]) { groups[f] = []; folderNames.push(f); }
    groups[f].push(src);
  });

  /* ------------------------------------------------------------------ *
   *  HELPERS
   * ------------------------------------------------------------------ */
  function windowBase(basedOn) {
    var w = document.documentElement.clientWidth;
    var h = document.documentElement.clientHeight;
    return basedOn === 'height' ? h : basedOn === 'smallest' ? Math.min(w, h) : w;
  }

  function computeSize() {
    var s = CONFIG.size;
    if (CONFIG.sizeUnit === 'percent') {
      s = windowBase(CONFIG.sizeBasedOn) * CONFIG.size / 100;
    }
    if (CONFIG.minSize > 0) s = Math.max(s, CONFIG.minSize);
    if (CONFIG.maxSize > 0) s = Math.min(s, CONFIG.maxSize);
    return Math.max(Math.round(s), 1);
  }

  // Distance (in px) the leader travels between two drops.
  function computeDropDistance() {
    return Math.max(windowBase(CONFIG.dropEveryBasedOn) * CONFIG.dropEvery / 100, 1);
  }

  function preload() {
    if (preloaded) return;
    preloaded = true;
    SVGS.forEach(function (src) { var i = new Image(); i.src = src; });
    if (CONFIG.leader) { var l = new Image(); l.src = CONFIG.leader; }
  }

  function shuffle(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
    }
    return arr;
  }

  // Any SVG, ignoring folders.
  function nextAnySrc() {
    if (CONFIG.order === 'sequential') {
      return SVGS[seqIndex++ % SVGS.length];
    }
    if (!queue.length) queue = shuffle(SVGS.slice()); // every SVG once before repeating
    return queue.pop();
  }

  // The folder for the next drop: never the same as the previous one.
  function nextFolder() {
    if (CONFIG.order === 'sequential') {
      return folderNames[folderSeq++ % folderNames.length];
    }
    if (!folderQueue.length) {
      folderQueue = shuffle(folderNames.slice());   // every folder once before repeating
      var last = folderQueue.length - 1;
      if (folderQueue[last] === lastFolder) {       // avoid the same folder twice in a row
        var t = folderQueue[0]; folderQueue[0] = folderQueue[last]; folderQueue[last] = t;
      }
    }
    return folderQueue.pop();
  }

  // One SVG out of a given folder.
  function nextSrcFrom(folder) {
    var list = groups[folder];
    if (CONFIG.order === 'sequential') {
      srcSeq[folder] = (srcSeq[folder] || 0);
      return list[srcSeq[folder]++ % list.length];
    }
    if (!srcQueues[folder] || !srcQueues[folder].length) srcQueues[folder] = shuffle(list.slice());
    return srcQueues[folder].pop();
  }

  function nextSrc() {
    if (!CONFIG.differentFolderEachDrop || folderNames.length < 2) return nextAnySrc();
    var folder = nextFolder();
    lastFolder = folder;
    return nextSrcFrom(folder);
  }

  function makeImg(src) {
    var img = document.createElement('img');
    img.src = src;
    img.alt = '';
    img.style.width = sizePx + 'px';
    img.style.height = sizePx + 'px';
    img.draggable = false;
    img.style.borderRadius = CONFIG.cornerRadius + 'px';
    img.style.backgroundColor = CONFIG.backgroundColor;
    if (CONFIG.shadow && CONFIG.shadowSize > 0) {
      img.style.boxShadow = '0 ' + Math.round(CONFIG.shadowSize / 3) + 'px ' +
                            CONFIG.shadowSize + 'px ' + CONFIG.shadowColor;
    }
    return img;
  }

  function place(el, px, py) {
    el.style.transform = 'translate3d(' + px.toFixed(2) + 'px,' + py.toFixed(2) + 'px,0)';
  }

  /* ------------------------------------------------------------------ *
   *  ANIMATION
   * ------------------------------------------------------------------ */
  function drop(px, py) {
    var img = makeImg(nextSrc());
    place(img, px, py);
    // Inserted before the leader: later drops come later in the DOM,
    // so each new drop sits above all earlier ones, and the leader stays on top.
    layer.insertBefore(img, leader);

    if (CONFIG.fade) {
      var delay = CONFIG.fadeDelaySeconds;
      var duration = CONFIG.fadeDurationSeconds;
      img.style.opacity = '1';
      img.style.transition = 'opacity ' + duration + 's linear ' + delay + 's';
      void img.offsetWidth;          // make the browser register opacity 1 first
      img.style.opacity = '0';       // ...then fade to 0 after the delay
      setTimeout(function () {
        if (img.parentNode) img.parentNode.removeChild(img);
      }, (delay + duration) * 1000 + 500);
    }

    if (CONFIG.maxDrops > 0) {
      while (layer.children.length - 1 > CONFIG.maxDrops) {
        layer.removeChild(layer.firstChild);
      }
    }
  }

  // Size of the area the squares move in.
  function bounds() {
    var r = layer.getBoundingClientRect();
    return { w: r.width, h: r.height };
  }

  // Plans ONE straight stretch of the path: from (x0, y0) in direction (dx, dy)
  // until a border is hit. The squares are spread evenly over this stretch,
  // with the last one exactly on the border.
  function beginSegment(x0, y0, dx, dy, dropAtStart) {
    var b = bounds();
    var maxX = Math.max(b.w - sizePx, 0);
    var maxY = Math.max(b.h - sizePx, 0);
    x0 = Math.min(Math.max(x0, 0), maxX);
    y0 = Math.min(Math.max(y0, 0), maxY);

    // Distance along each axis to the border we are heading for.
    var ax = maxX > 0 ? (dx > 0 ? maxX - x0 : x0) : Infinity;
    var ay = maxY > 0 ? (dy > 0 ? maxY - y0 : y0) : Infinity;
    var a = Math.min(ax, ay);
    if (!isFinite(a)) a = 0;                    // window smaller than a square: nothing to bounce on

    var EPS = 1e-6;
    var hitX = isFinite(ax) && ax - a < EPS;    // both are true when we hit a corner
    var hitY = isFinite(ay) && ay - a < EPS;
    var x1 = hitX ? (dx > 0 ? maxX : 0) : Math.min(Math.max(x0 + dx * a, 0), maxX);
    var y1 = hitY ? (dy > 0 ? maxY : 0) : Math.min(Math.max(y0 + dy * a, 0), maxY);

    var L = a * Math.SQRT2;                     // diagonal length of this stretch
    var n = L > EPS ? Math.max(1, Math.round(L / dropPx)) : 0;   // squares on this stretch

    seg = {
      x0: x0, y0: y0, x1: x1, y1: y1,
      dx: dx, dy: dy,                           // direction we are moving in
      ndx: hitX ? -dx : dx,                     // direction after the bounce
      ndy: hitY ? -dy : dy,
      L: L, n: n,
      spacing: n ? L / n : 0,                   // equal distance between the squares
      s: 0,                                     // distance travelled on this stretch
      k: (dropAtStart && n) ? 0 : 1             // next square to drop (n = the one on the border)
    };
  }

  // The point at a given distance along the current stretch.
  function pointAt(d) {
    if (seg.L <= 0) return { x: seg.x0, y: seg.y0 };
    if (d >= seg.L) return { x: seg.x1, y: seg.y1 };      // exactly on the border
    var f = d / seg.L;
    return { x: seg.x0 + (seg.x1 - seg.x0) * f, y: seg.y0 + (seg.y1 - seg.y0) * f };
  }

  function tick(t) {
    if (!running) return;

    var dt = Math.min((t - lastT) / 1000, 0.05); // clamp, e.g. after a tab switch
    lastT = t;

    var advance = CONFIG.speed * dt;             // distance to travel this frame
    var guard = 0;
    while (advance > 0 && guard++ < 50) {
      var step = Math.min(advance, seg.L - seg.s);
      seg.s += step;
      advance -= step;

      // Leave a square at every planned spot we have passed, at its exact position.
      while (seg.k <= seg.n) {
        var dist = seg.k === seg.n ? seg.L : seg.k * seg.spacing;
        if (dist > seg.s + 1e-9) break;
        var p = pointAt(dist);
        drop(p.x, p.y);
        seg.k++;
      }

      // Reached the border: bounce and plan the next stretch.
      if (seg.s >= seg.L - 1e-9) beginSegment(seg.x1, seg.y1, seg.ndx, seg.ndy, false);
    }

    var pos = pointAt(seg.s);
    place(leader, pos.x, pos.y);

    rafId = requestAnimationFrame(tick);
  }

  function start() {
    if (running) return;
    preload();

    layer = document.createElement('div');
    layer.id = 'idle-bouncer';
    layer.setAttribute('aria-hidden', 'true');
    layer.style.transition = 'opacity ' + CONFIG.fadeOutMs + 'ms ease';

    sizePx = computeSize();
    dropPx = computeDropDistance();
    leader = makeImg(CONFIG.leader || SVGS[Math.floor(Math.random() * SVGS.length)]);
    layer.appendChild(leader);
    document.body.appendChild(layer);

    var b = bounds();
    var maxX = Math.max(b.w - sizePx, 0);
    var maxY = Math.max(b.h - sizePx, 0);
    // Random start spot, moving diagonally like the DVD logo.
    beginSegment(Math.random() * maxX, Math.random() * maxY,
                 Math.random() < 0.5 ? -1 : 1, Math.random() < 0.5 ? -1 : 1, true);
    place(leader, seg.x0, seg.y0);

    running = true;
    lastT = performance.now();
    rafId = requestAnimationFrame(tick);
  }

  function stop() {
    running = false;
    cancelAnimationFrame(rafId);
    if (!layer) return;
    var old = layer;
    layer = leader = null;
    old.classList.add('is-hiding');
    setTimeout(function () {
      if (old.parentNode) old.parentNode.removeChild(old);
    }, CONFIG.fadeOutMs + 50);
  }

  /* ------------------------------------------------------------------ *
   *  IDLE DETECTION
   * ------------------------------------------------------------------ */
  function onActivity() {
    if (running) stop();
    clearTimeout(idleTimer);
    idleTimer = setTimeout(start, CONFIG.idleSeconds * 1000);
  }

  ['mousemove', 'mousedown', 'keydown', 'wheel', 'touchstart', 'scroll'].forEach(function (evt) {
    window.addEventListener(evt, onActivity, { passive: true });
  });

  // When the window is resized while the animation runs, resize all squares too.
  window.addEventListener('resize', function () {
    if (!running || !layer) return;
    dropPx = computeDropDistance();
    var n = computeSize();
    if (n !== sizePx) {
      sizePx = n;
      for (var i = 0; i < layer.children.length; i++) {
        layer.children[i].style.width = n + 'px';
        layer.children[i].style.height = n + 'px';
      }
    }
    // Carry on from the current spot, planned for the new window size.
    var p = pointAt(seg.s);
    beginSegment(p.x, p.y, seg.dx, seg.dy, false);
  });

  onActivity();
})();
</script>
{% endif %}