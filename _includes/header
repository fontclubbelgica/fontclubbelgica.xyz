<!-- header -->

<header>
    <div>
        <nav class="main-menu">
            <h2>{% include fcb %}</h2>
            <ul>
                <li><a href="/typefaces">Typefaces</a></li>
                <li><a href="/articles">Research & News</a></li>
                <li><a href="/next">What's next</a></li>
            </ul>
        </nav>
    </div>

    <div>
        <nav class="font-menu">
            {% if page.layout == "font" %}
            <h2>{{ page.title }}</h2>
            {% else %}
            <h2>Typefaces</h2>
            {% endif %}
            <ul>
            {% assign typefaces = site.typefaces | sort:"date" %}
            {% for fontPage in typefaces %}
                {% unless fontPage.draft %}
                {% if fontPage != page %}
                    <li><a href="{{ fontPage.url}}">{{ fontPage.title }}</a></li>
                {% endif %}
                {% endunless %}
            {% endfor %}
            </ul>
        </nav>
    </div>

    <div>
        <nav class="cart">
            <a href="#">Add to cart</a>
        </nav>
    </div>
</header>