<!-- header -->

<header>
    <nav>
        <div class="dropdown">
            {% include fcb %}
            <div class="dropdown-options">
                <a href="/typefaces">Typefaces</a>
                <a href="/articles">Research & News</a>
                <a href="/next">What's next</a>
            </div>
        </div>
        {% if page.layout == "font" %}
        <div class="dropdown">
            <div>{{ page.title }} ↕</div>
            <div class="dropdown-options">
                {% for fontPage in site.typefaces %}
                    {% if fontPage != page %}
                        <a href="{{ fontPage.url}}">{{ fontPage.title }}</a>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        {% endif %}
        <div class="dropdown">Cart</div>
    </nav>
</header>